{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "jsxImportSource": "preact",
    "types": ["vite/client", "node"],
    "isolatedModules": true,
    "resolveJsonModule": true
  },
  "include": ["src", "api", "tests", "scripts", "*.ts"]
}
